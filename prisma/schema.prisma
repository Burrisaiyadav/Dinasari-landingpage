// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id        Int      @id @default(autoincrement())
  jobTitle  String
  name      String
  email     String
  resume    String
  portfolio String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("applications")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  email     String
  firm      String
  message   String?
  createdAt DateTime @default(now())

  @@map("inquiries")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletters")
}
